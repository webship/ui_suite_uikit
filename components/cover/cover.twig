{% set height = height|default('medium') %}
{% set attributes = attributes.addClass('uk-cover-container').addClass('uk-position-relative') %}
{% if height == 'viewport' %}
  {% set attributes = attributes.setAttribute('uk-height-viewport', '') %}
{% else %}
  {% set attributes = attributes.addClass('uk-height-' ~ height) %}
{% endif %}
<div{{ attributes }}>
  <div class="uk-position-cover uk-cover-media">
    {{ media }}
  </div>
  {% set overlay_default = 'none' %}
  {% if inverse == 'light' %}
    {% set overlay_default = 'primary' %}
  {% elseif inverse == 'dark' %}
    {% set overlay_default = 'default' %}
  {% endif %}
  {% set overlay = overlay|default(overlay_default) %}
  {% if content %}
    <div class="uk-position-{{ content_position|default('center') }} uk-position-medium{{ inverse ? ' uk-' ~ inverse }}{{ overlay != 'none' ? ' uk-overlay uk-overlay-' ~ overlay }}">
      {{ content }}
    </div>
  {% endif %}
</div>
