{#
/**
 * @file
 * The footer of the site: the contentinfo landmark, a full-width band.
 */
#}
{% set variant = variant|default('secondary') %}
{% set size = size|default('small') %}
{% set attributes = attributes.addClass([
  'ui-suite-uikit-footer',
  'uk-section',
  'uk-section-' ~ variant,
  size != 'medium' ? 'uk-section-' ~ size,
]) %}
<footer{{ attributes }}>
  <div class="uk-container">
    {{ content }}
    {% if bottom or totop %}
      <div class="ui-suite-uikit-footer__bottom uk-margin-top">
        <div>{{ bottom }}</div>
        {% if totop %}
          <a class="uk-totop" href="#" uk-totop aria-label="{{ 'Back to top'|t }}"></a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</footer>
