{#
/**
 * @file
 * Theme override for menus placed in the navbar regions: UIkit Navbar nav.
 *
 * Menus in the center region are hidden on small screens: the Offcanvas
 * region takes over there.
 *
 * Available variables:
 * - items: A nested list of menu items.
 * - uikit_region: The region of the menu block.
 *
 * @see \Drupal\ui_suite_uikit\Hook\ThemeHooks::themeSuggestionsMenuAlter()
 */
#}
{% if items %}
  {{ include('ui_suite_uikit:navbar_nav', {
    items: items,
    attributes: {
      class: uikit_region == 'navbar_center' ? ['uk-visible@m'] : [],
    },
  }, with_context: false) }}
{% endif %}
