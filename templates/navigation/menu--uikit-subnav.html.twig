{#
/**
 * @file
 * Theme override for menus placed in the footer region: UIkit Subnav.
 *
 * Available variables:
 * - items: A nested list of menu items (only the first level is printed).
 *
 * @see \Drupal\ui_suite_uikit\Hook\ThemeHooks::themeSuggestionsMenuAlter()
 */
#}
{% if items %}
  {{ include('ui_suite_uikit:subnav', {
    items: items,
    variant: 'divider',
  }, with_context: false) }}
{% endif %}
