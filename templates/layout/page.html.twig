{#
/**
 * @file
 * Theme override to display a single page.
 *
 * Built with the page parts of the theme: the Page, Header and Footer
 * components, which the Display Builder page layouts use too, and the Navbar
 * and Offcanvas components. page--sign-in.html.twig extends this template
 * and replaces the "page" block.
 *
 * The page template also renders in the "theme page" of a Display Builder
 * page layout, without the preprocess of the theme: the variables below have
 * a default.
 *
 * Available variables (in addition to core ones):
 * - navbar_sticky: Whether the navbar sticks to the top (theme setting).
 * - offcanvas_id: The ID of the offcanvas printing the "Offcanvas" region.
 *
 * Regions:
 * - page.navbar_left, page.navbar_center, page.navbar_right: Navbar.
 * - page.offcanvas: Offcanvas, opened by the navbar toggle on small screens.
 * - page.header: Below the navbar (breadcrumb...).
 * - page.highlighted, page.help: Above the content.
 * - page.content: The main content of the current page.
 * - page.sidebar_first, page.sidebar_second: Sidebars.
 * - page.footer: Footer.
 *
 * @see template_preprocess_page()
 * @see \Drupal\ui_suite_uikit\Hook\ThemeHooks::preprocessPage()
 */
#}
{% set offcanvas_id = offcanvas_id|default('ui-suite-uikit-offcanvas') %}
{% set sticky = navbar_sticky is defined ? navbar_sticky : true %}

{% set site_header = null %}
{% if page.navbar_left or page.navbar_center or page.navbar_right or page.offcanvas %}
  {% set site_header = {
    '#type': 'component',
    '#component': 'ui_suite_uikit:header',
    '#slots': {
      'content': {
        '#type': 'component',
        '#component': 'ui_suite_uikit:navbar',
        '#props': {
          'sticky': sticky,
        },
        '#slots': {
          'left': page.navbar_left,
          'center': page.navbar_center,
          'right': [page.navbar_right, page.offcanvas ? {
            '#type': 'component',
            '#component': 'ui_suite_uikit:navbar_toggle',
            '#props': {
              'target': offcanvas_id,
              'attributes': {
                'class': ['uk-hidden@m'],
              },
            },
          }],
        },
      },
      'offcanvas': page.offcanvas ? {
        '#type': 'component',
        '#component': 'ui_suite_uikit:offcanvas',
        '#props': {
          'offcanvas_id': offcanvas_id,
          'mode': 'push',
          'flip': true,
          'overlay': true,
          'close': true,
        },
        '#slots': {
          'content': page.offcanvas,
        },
      },
    },
  } %}
{% endif %}

{% set site_footer = page.footer ? {
  '#type': 'component',
  '#component': 'ui_suite_uikit:footer',
  '#props': {
    'variant': 'secondary',
    'size': 'small',
    'totop': true,
  },
  '#slots': {
    'content': page.footer,
  },
} %}

{% block page %}
  {# Blocks like the breadcrumb can render nothing: skip the empty band. #}
  {% set above = page.header|render %}
  {{ include('ui_suite_uikit:page', {
    header: site_header,
    above: above|striptags('<img><svg><form><input>')|trim ? above,
    highlighted: [page.highlighted, page.help],
    content: page.content,
    sidebar_first: page.sidebar_first,
    sidebar_second: page.sidebar_second,
    footer: site_footer,
  }, with_context: false) }}
{% endblock %}
